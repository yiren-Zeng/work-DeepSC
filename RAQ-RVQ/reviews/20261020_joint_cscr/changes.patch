+class FourWaySelectionTests(unittest.TestCase):
+    def test_mode_resolution_and_cli_forwarding(self):
+        self.assertEqual(resolve_cscr_mode(), "off")
+        self.assertEqual(resolve_cscr_mode(True), "stage")
+        self.assertEqual(resolve_cscr_mode(True, "joint-pack"), "joint-pack")
